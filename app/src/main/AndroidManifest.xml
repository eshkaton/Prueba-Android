<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Necesario para la grabadora de notas de voz. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- La app funciona sin micrófono: solo se pierde la grabación. -->
    <uses-feature
        android:name="android.hardware.microphone"
        android:required="false" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Registromultimedia">

        <!-- 1. Acceso: primera pantalla del flujo. -->
        <activity
            android:name=".LoginActivity"
            android:exported="true"
            android:theme="@style/Theme.Registromultimedia.Acceso"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".RegisterActivity"
            android:exported="false"
            android:label="@string/registro_titulo"
            android:parentActivityName=".LoginActivity"
            android:theme="@style/Theme.Registromultimedia.Acceso"
            android:windowSoftInputMode="adjustResize" />

        <!-- 2. Bienvenida: hospeda el resto de vistas con su barra de menú. -->
        <activity
            android:name=".WelcomeActivity"
            android:exported="false"
            android:label="@string/app_name"
            android:windowSoftInputMode="adjustResize" />

        <!-- 3. Vistas que se abren desde la bienvenida. -->
        <activity
            android:name=".DetalleIntegranteActivity"
            android:exported="false"
            android:label="@string/detalle_titulo"
            android:parentActivityName=".WelcomeActivity" />

        <activity
            android:name=".GrabacionAudioActivity"
            android:exported="false"
            android:label="@string/grabacion_titulo"
            android:parentActivityName=".WelcomeActivity" />

        <activity
            android:name=".ReproductorAudioActivity"
            android:exported="false"
            android:label="@string/reproductor_titulo"
            android:parentActivityName=".WelcomeActivity" />

    </application>

</manifest>

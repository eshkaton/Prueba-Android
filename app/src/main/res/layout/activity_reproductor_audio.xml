<?xml version="1.0" encoding="utf-8"?>
<!-- Biblioteca de grabaciones: lista arriba, reproductor fijo abajo. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    android:orientation="vertical"
    tools:context=".ReproductorAudioActivity">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbarReproductor"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:navigationContentDescription="@string/desc_volver"
        app:navigationIcon="@drawable/ic_atras"
        app:title="@string/reproductor_titulo" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvAudios"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingStart="@dimen/esp_l"
            android:paddingTop="@dimen/esp_s"
            android:paddingEnd="@dimen/esp_l"
            android:paddingBottom="@dimen/esp_l"
            android:scrollbars="vertical"
            tools:itemCount="3"
            tools:listitem="@layout/item_audio" />

        <LinearLayout
            android:id="@+id/lyVacio"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="@dimen/esp_xl"
            android:visibility="gone"
            tools:visibility="visible">

            <ImageView
                android:layout_width="88dp"
                android:layout_height="88dp"
                android:background="@drawable/bg_circulo_variante"
                android:contentDescription="@null"
                android:padding="@dimen/esp_xl"
                android:src="@drawable/ic_ondas"
                app:tint="?attr/colorOnSurfaceVariant" />

            <TextView
                android:id="@+id/txtSinAudios"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/esp_l"
                android:gravity="center"
                android:text="@string/reproductor_vacio"
                android:textAppearance="@style/TextAppearance.App.BodyLarge"
                android:textColor="?attr/colorOnSurfaceVariant" />

        </LinearLayout>

    </FrameLayout>

    <!-- ============ REPRODUCTOR ============ -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/lyReproductorActual"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/esp_m"
        app:cardCornerRadius="@dimen/radio_m">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/esp_l">

            <TextView
                android:id="@+id/txtNombreSeleccionado"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/reproductor_selecciona"
                android:textAppearance="@style/TextAppearance.App.TitleMedium"
                android:textColor="?attr/colorOnSurface" />

            <TextView
                android:id="@+id/txtFechaSeleccionado"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textAppearance="@style/TextAppearance.App.BodyMedium"
                android:textColor="?attr/colorOnSurfaceVariant"
                tools:text="22/09/2026 15:12" />

            <SeekBar
                android:id="@+id/seekPlayer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/esp_m"
                android:enabled="false" />

            <TextView
                android:id="@+id/txtTiempoPlayer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="@dimen/esp_m"
                android:paddingEnd="@dimen/esp_m"
                android:text="@string/reproductor_tiempo_inicial"
                android:textAppearance="@style/TextAppearance.App.Cronometro"
                android:textColor="?attr/colorOnSurfaceVariant" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/esp_m"
                android:gravity="center"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">

                    <ImageButton
                        android:id="@+id/imgbtnCortar"
                        android:layout_width="@dimen/boton_circular"
                        android:layout_height="@dimen/boton_circular"
                        android:background="@drawable/bg_circulo_variante"
                        android:contentDescription="@string/accion_cortar"
                        android:enabled="false"
                        android:padding="@dimen/esp_l"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_tijeras"
                        app:tint="?attr/colorOnSurfaceVariant" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/esp_xs"
                        android:text="@string/accion_cortar"
                        android:textAppearance="@style/TextAppearance.App.Overline"
                        android:textColor="?attr/colorOnSurfaceVariant" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">

                    <ImageButton
                        android:id="@+id/imgbtnPlayPausePlayer"
                        android:layout_width="@dimen/boton_circular_grande"
                        android:layout_height="@dimen/boton_circular_grande"
                        android:background="@drawable/bg_circulo_primario"
                        android:contentDescription="@string/accion_reproducir"
                        android:enabled="false"
                        android:padding="@dimen/esp_xl"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_reproducir"
                        app:tint="?attr/colorOnPrimary" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/esp_xs"
                        android:text="@string/accion_reproducir"
                        android:textAppearance="@style/TextAppearance.App.Overline"
                        android:textColor="?attr/colorOnSurfaceVariant" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">

                    <ImageButton
                        android:id="@+id/imgbtnEliminar"
                        android:layout_width="@dimen/boton_circular"
                        android:layout_height="@dimen/boton_circular"
                        android:background="@drawable/bg_circulo_error"
                        android:contentDescription="@string/accion_eliminar"
                        android:enabled="false"
                        android:padding="@dimen/esp_l"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_papelera"
                        app:tint="?attr/colorOnError" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/esp_xs"
                        android:text="@string/accion_eliminar"
                        android:textAppearance="@style/TextAppearance.App.Overline"
                        android:textColor="?attr/colorOnSurfaceVariant" />

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<!-- Alta de cuenta. Comparte el tema y el degradado de la pantalla de acceso. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:fitsSystemWindows="true"
    android:scrollbars="none"
    tools:context=".RegisterActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/esp_xl"
        android:paddingTop="@dimen/esp_l"
        android:paddingEnd="@dimen/esp_xl"
        android:paddingBottom="@dimen/esp_xl">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:contentDescription="@string/desc_volver"
            android:focusable="true"
            android:padding="@dimen/esp_s"
            android:src="@drawable/ic_atras"
            app:tint="@color/blanco" />

        <ImageView
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="@dimen/esp_xl"
            android:background="@drawable/bg_circulo_translucido"
            android:contentDescription="@string/desc_logo"
            android:padding="@dimen/esp_l"
            android:src="@drawable/ic_agregar_persona"
            app:tint="@color/blanco" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/esp_l"
            android:text="@string/registro_titulo"
            android:textAlignment="center"
            android:textAppearance="@style/TextAppearance.App.HeadlineMedium"
            android:textColor="@color/blanco" />

        <TextView
            android:id="@+id/txtSubtitleRegister"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/esp_s"
            android:text="@string/registro_subtitulo"
            android:textAlignment="center"
            android:textAppearance="@style/TextAppearance.App.BodyMedium"
            android:textColor="@color/blanco_80" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilRegisterEmail"
            style="@style/Widget.App.TextInputLayout.Acceso"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/esp_xxl"
            android:hint="@string/registro_correo"
            app:startIconDrawable="@drawable/ic_correo">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/editRegisterEmail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:autofillHints="emailAddress"
                android:imeOptions="actionNext"
                android:inputType="textEmailAddress"
                android:maxLines="1" />

        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilRegisterPassword"
            style="@style/Widget.App.TextInputLayout.Acceso"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/esp_m"
            android:hint="@string/registro_password"
            app:endIconMode="password_toggle"
            app:helperText="@string/registro_ayuda_password"
            app:helperTextTextColor="@color/blanco_60"
            app:startIconDrawable="@drawable/ic_candado">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/editRegisterPassword"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:autofillHints="newPassword"
                android:imeOptions="actionNext"
                android:inputType="textPassword"
                android:maxLines="1" />

        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilRegisterPassword2"
            style="@style/Widget.App.TextInputLayout.Acceso"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/esp_m"
            android:hint="@string/registro_password_repetir"
            app:endIconMode="password_toggle"
            app:startIconDrawable="@drawable/ic_verificado">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/editRegisterPassword2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:autofillHints="newPassword"
                android:imeOptions="actionDone"
                android:inputType="textPassword"
                android:maxLines="1" />

        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnConfirmRegister"
            style="@style/Widget.App.Button.Acceso"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/esp_xl"
            android:text="@string/registro_confirmar" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/txtBackToLogin"
            style="@style/Widget.App.Button.Text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/esp_l"
            android:text="@string/registro_volver"
            android:textColor="@color/blanco" />

    </LinearLayout>

</ScrollView>

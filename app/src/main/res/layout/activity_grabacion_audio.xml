<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        tools:context=".MainActivity">

        <LinearLayout
            android:id="@+id/lyBar"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="#203A97"
            android:paddingTop="16dp"
            android:paddingBottom="16dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:id="@+id/btnVolver"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:src="@android:drawable/ic_menu_revert"
                android:contentDescription="@string/volver"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/txtTitulo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="18dp"
                android:text="@string/grabacion_audio"
                android:textSize="18sp"
                android:textColor="#FFFFFF" />

        </LinearLayout>

        <ImageView
            android:id="@+id/imgbtnEstado"
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:layout_marginTop="56dp"
            android:scaleType="fitCenter"
            android:padding="16dp"
            android:src="@android:drawable/ic_btn_speak_now"
            android:background="@drawable/circulo_fondo"
            android:contentDescription="@string/estado_grabacion"
            app:tint="#FFFFFF"
            app:layout_constraintTop_toBottomOf="@id/lyBar"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <TextView
            android:id="@+id/txtTitulo2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/listo_para_grabar"
            android:textSize="18sp"
            app:layout_constraintTop_toBottomOf="@id/imgbtnEstado"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <TextView
            android:id="@+id/txtSubtitulo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/toca_boton_comenzar"
            android:textColor="#888888"
            app:layout_constraintTop_toBottomOf="@id/txtTitulo2"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <LinearLayout
            android:id="@+id/lyBotones"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:layout_marginTop="50dp"
            app:layout_constraintTop_toBottomOf="@id/txtSubtitulo"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <LinearLayout
                android:id="@+id/lyGrabar"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center_horizontal">

                <ImageButton
                    android:id="@+id/imgbtnGrabar"
                    android:layout_width="70dp"
                    android:layout_height="70dp"
                    android:background="@drawable/circulo_rojo"
                    android:src="@drawable/circulo_blanco"
                    android:padding="21dp"
                    android:contentDescription="@string/grabar_audio" />

                <TextView
                    android:id="@+id/txtGrabar"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/grabar" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/lyDetener"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center_horizontal">

                <ImageButton
                    android:id="@+id/imgbtnDetener"
                    android:layout_width="70dp"
                    android:layout_height="70dp"
                    android:background="@drawable/circulo_gris"
                    android:src="@drawable/cuadrado_gris"
                    android:padding="21dp"
                    android:contentDescription="@string/detener_grabacion" />

                <TextView
                    android:id="@+id/txtDetener"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/detener" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/lyGuardar"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center_horizontal">

                <ImageButton
                    android:id="@+id/imgbtnGuardar"
                    android:layout_width="70dp"
                    android:layout_height="70dp"
                    android:background="@drawable/circulo_gris"
                    android:src="@android:drawable/ic_menu_save"
                    android:contentDescription="@string/guardar_grabacion" />

                <TextView
                    android:id="@+id/txtGuardar"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/guardar" />

            </LinearLayout>

        </LinearLayout>

        <LinearLayout
            android:id="@+id/lyTodo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="60dp"
            android:layout_marginBottom="24dp"
            android:orientation="vertical"
            android:background="@drawable/fondo_tarjeta"
            android:padding="16dp"
            app:layout_constraintTop_toBottomOf="@id/lyBotones"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <TextView
                android:id="@+id/txtTitulo3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ultima_grabacion" />

            <LinearLayout
                android:id="@+id/lyReproductor"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageButton
                    android:id="@+id/imgbtnReproducir"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:background="@drawable/circulo_morado"
                    android:src="@android:drawable/ic_media_play"
                    android:contentDescription="@string/reproducir_audio" />

                <SeekBar
                    android:id="@+id/seekReproductor"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1" />

            </LinearLayout>

            <TextView
                android:id="@+id/txtTiempo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="64dp"
                android:paddingBottom="12dp"
                android:text="@string/tiempo_audio_inicial" />

            <Button
                android:id="@+id/btnReproducirAudio"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/reproducir_audio"
                android:textColor="#000000"
                app:backgroundTint="#D0D0D0" />

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</ScrollView>
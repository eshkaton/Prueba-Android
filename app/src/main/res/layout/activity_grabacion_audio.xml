<?xml version="1.0" encoding="utf-8"?>
<!-- Grabadora de notas de voz. Se abre desde el menú superior. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    android:orientation="vertical"
    tools:context=".GrabacionAudioActivity">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbarGrabacion"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:navigationContentDescription="@string/desc_volver"
        app:navigationIcon="@drawable/ic_atras"
        app:title="@string/grabacion_titulo" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="@dimen/esp_l"
            android:paddingTop="@dimen/esp_xl"
            android:paddingEnd="@dimen/esp_l"
            android:paddingBottom="@dimen/esp_xl">

            <!-- ============ ESTADO ============ -->
            <ImageView
                android:id="@+id/imgbtnEstado"
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:background="@drawable/bg_circulo_suave"
                android:contentDescription="@string/desc_estado_grabacion"
                android:padding="@dimen/esp_xxl"
                android:src="@drawable/ic_microfono"
                app:tint="?attr/colorOnPrimaryContainer" />

            <TextView
                android:id="@+id/txtEstado"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/esp_l"
                android:text="@string/grabacion_listo"
                android:textAlignment="center"
                android:textAppearance="@style/TextAppearance.App.HeadlineSmall"
                android:textColor="?attr/colorOnBackground" />

            <TextView
                android:id="@+id/txtEstadoDetalle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/esp_xs"
                android:text="@string/grabacion_listo_detalle"
                android:textAlignment="center"
                android:textAppearance="@style/TextAppearance.App.BodyMedium"
                android:textColor="?attr/colorOnSurfaceVariant" />

            <!-- ============ CONTROLES ============ -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/esp_xxl"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">

                    <ImageButton
                        android:id="@+id/imgbtnGrabar"
                        android:layout_width="@dimen/boton_circular_grande"
                        android:layout_height="@dimen/boton_circular_grande"
                        android:background="@drawable/bg_circulo_error"
                        android:contentDescription="@string/accion_grabar"
                        android:padding="@dimen/esp_xl"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_microfono"
                        app:tint="?attr/colorOnError" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/esp_s"
                        android:text="@string/accion_grabar"
                        android:textAppearance="@style/TextAppearance.App.Overline"
                        android:textColor="?attr/colorOnSurfaceVariant" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">

                    <ImageButton
                        android:id="@+id/imgbtnDetener"
                        android:layout_width="@dimen/boton_circular_grande"
                        android:layout_height="@dimen/boton_circular_grande"
                        android:background="@drawable/bg_circulo_variante"
                        android:contentDescription="@string/accion_detener"
                        android:padding="@dimen/esp_xl"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_detener"
                        app:tint="?attr/colorOnSurfaceVariant" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/esp_s"
                        android:text="@string/accion_detener"
                        android:textAppearance="@style/TextAppearance.App.Overline"
                        android:textColor="?attr/colorOnSurfaceVariant" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">

                    <ImageButton
                        android:id="@+id/imgbtnGuardar"
                        android:layout_width="@dimen/boton_circular_grande"
                        android:layout_height="@dimen/boton_circular_grande"
                        android:background="@drawable/bg_circulo_secundario"
                        android:contentDescription="@string/accion_guardar"
                        android:padding="@dimen/esp_xl"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_guardar"
                        app:tint="?attr/colorOnSecondary" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/esp_s"
                        android:text="@string/accion_guardar"
                        android:textAppearance="@style/TextAppearance.App.Overline"
                        android:textColor="?attr/colorOnSurfaceVariant" />

                </LinearLayout>

            </LinearLayout>

            <!-- ============ ÚLTIMA GRABACIÓN ============ -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/esp_xxl"
                app:cardCornerRadius="@dimen/radio_m">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/esp_l">

                    <TextView
                        style="@style/Texto.Etiqueta"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/grabacion_ultima" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/esp_m"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageButton
                            android:id="@+id/imgbtnReproducir"
                            android:layout_width="@dimen/boton_circular"
                            android:layout_height="@dimen/boton_circular"
                            android:background="@drawable/bg_circulo_primario"
                            android:contentDescription="@string/accion_reproducir"
                            android:padding="@dimen/esp_l"
                            android:scaleType="fitCenter"
                            android:src="@drawable/ic_reproducir"
                            app:tint="?attr/colorOnPrimary" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/esp_m"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <SeekBar
                                android:id="@+id/seekReproductor"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content" />

                            <TextView
                                android:id="@+id/txtTiempo"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:paddingStart="@dimen/esp_m"
                                android:paddingEnd="@dimen/esp_m"
                                android:text="@string/reproductor_tiempo_inicial"
                                android:textAppearance="@style/TextAppearance.App.Cronometro"
                                android:textColor="?attr/colorOnSurfaceVariant" />

                        </LinearLayout>

                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnReproducirAudio"
                        style="@style/Widget.App.Button.Outlined"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/esp_m"
                        android:text="@string/accion_reproducir"
                        app:icon="@drawable/ic_reproducir"
                        app:iconGravity="textStart" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

    </ScrollView>

</LinearLayout>

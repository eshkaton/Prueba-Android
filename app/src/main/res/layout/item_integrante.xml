<?xml version="1.0" encoding="utf-8"?>
<!-- Fila del listado de integrantes. -->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/esp_m"
    android:clickable="true"
    android:focusable="true"
    app:cardCornerRadius="@dimen/radio_m">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="@dimen/esp_l">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/imgFoto"
            android:layout_width="@dimen/avatar_lista"
            android:layout_height="@dimen/avatar_lista"
            android:contentDescription="@string/desc_avatar"
            android:scaleType="centerCrop"
            app:shapeAppearanceOverlay="@style/ShapeAppearance.App.Circular"
            app:strokeColor="?attr/colorPrimaryContainer"
            app:strokeWidth="2dp"
            tools:src="@drawable/ic_avatar_generico" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/esp_l"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvNombre"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textAppearance="@style/TextAppearance.App.TitleMedium"
                android:textColor="?attr/colorOnSurface"
                tools:text="Lucas Bilbao" />

            <TextView
                android:id="@+id/tvRol"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/esp_xs"
                android:background="@drawable/bg_pildora_suave"
                android:paddingStart="@dimen/esp_m"
                android:paddingTop="3dp"
                android:paddingEnd="@dimen/esp_m"
                android:paddingBottom="3dp"
                android:textAppearance="@style/TextAppearance.App.Overline"
                android:textColor="?attr/colorOnSecondaryContainer"
                tools:text="Desarrollador" />

            <RatingBar
                android:id="@+id/ratingBar"
                style="?android:attr/ratingBarStyleSmall"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/esp_s"
                android:isIndicator="true"
                android:numStars="5"
                android:stepSize="0.5"
                tools:rating="4.5" />

        </LinearLayout>

        <ImageView
            android:layout_width="@dimen/icono_m"
            android:layout_height="@dimen/icono_m"
            android:contentDescription="@null"
            android:src="@drawable/ic_flecha_derecha"
            app:tint="?attr/colorOutline" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>

<?xml version="1.0" encoding="utf-8"?>
<resources>

      <!-- ============================================================ -->
      <!-- TIPOGRAFÍA — familias del sistema, sin descargar fuentes      -->
      <!-- ============================================================ -->

      <style name="Brand.Text.Display">
                <item name="android:fontFamily">sans-serif-black</item>
                <item name="android:textColor">@color/brand_on_primary</item>
                <item name="android:textSize">26sp</item>
                <item name="android:letterSpacing">0.01</item>
      </style>

      <style name="Brand.Text.Heading">
                <item name="android:fontFamily">sans-serif-condensed-medium</item>
                <item name="android:textColor">@color/brand_primary</item>
                <item name="android:textSize">18sp</item>
                <item name="android:letterSpacing">0.01</item>
      </style>

      <style name="Brand.Text.Body">
                <item name="android:fontFamily">sans-serif</item>
                <item name="android:textColor">@color/brand_text</item>
                <item name="android:textSize">15sp</item>
      </style>

      <style name="Brand.Text.Muted">
                <item name="android:fontFamily">sans-serif-light</item>
                <item name="android:textColor">@color/brand_text_muted</item>
                <item name="android:textSize">13sp</item>
      </style>

      <!-- ============================================================ -->
      <!-- BOTONES                                                       -->
      <!-- ============================================================ -->

      <style name="Brand.Button.Primary">
                <item name="android:fontFamily">sans-serif-medium</item>
                <item name="android:textAllCaps">false</item>
                <item name="android:textColor">@color/brand_on_primary</item>
                <item name="android:backgroundTint">@color/brand_accent</item>
                <item name="android:paddingTop">14dp</item>
                <item name="android:paddingBottom">14dp</item>
                <item name="android:textSize">15sp</item>
      </style>

      <style name="Brand.Button.Secondary">
                <item name="android:fontFamily">sans-serif-medium</item>
                <item name="android:textAllCaps">false</item>
                <item name="android:textColor">@color/brand_primary</item>
                <item name="android:backgroundTint">@color/brand_surface</item>
                <item name="android:paddingTop">14dp</item>
                <item name="android:paddingBottom">14dp</item>
                <item name="android:textSize">15sp</item>
      </style>

      <!-- Tarjeta de acción rápida en el Home -->
      <style name="Brand.Card">
                <item name="cardCornerRadius">18dp</item>
                <item name="cardElevation">3dp</item>
                <item name="cardBackgroundColor">@color/brand_surface</item>
      </style>

</resources>

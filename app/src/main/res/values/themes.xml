<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!--
        Tema claro. Todos los colores de la app se resuelven a través de estos
        roles de Material 3, por eso el modo oscuro funciona sin tocar layouts.
    -->
    <style name="Base.Theme.Registromultimedia" parent="Theme.Material3.DayNight.NoActionBar">

        <!-- Marca -->
        <item name="colorPrimary">@color/aurora_40</item>
        <item name="colorOnPrimary">@color/blanco</item>
        <item name="colorPrimaryContainer">@color/aurora_90</item>
        <item name="colorOnPrimaryContainer">@color/aurora_20</item>

        <!-- Secundario: audio -->
        <item name="colorSecondary">@color/turquesa_40</item>
        <item name="colorOnSecondary">@color/blanco</item>
        <item name="colorSecondaryContainer">@color/turquesa_90</item>
        <item name="colorOnSecondaryContainer">@color/turquesa_20</item>

        <!-- Terciario: acentos cálidos -->
        <item name="colorTertiary">@color/coral_40</item>
        <item name="colorOnTertiary">@color/blanco</item>
        <item name="colorTertiaryContainer">@color/coral_90</item>
        <item name="colorOnTertiaryContainer">@color/coral_20</item>

        <!-- Error -->
        <item name="colorError">@color/rojo_40</item>
        <item name="colorOnError">@color/blanco</item>
        <item name="colorErrorContainer">@color/rojo_90</item>
        <item name="colorOnErrorContainer">@color/rojo_20</item>

        <!-- Superficies -->
        <item name="android:colorBackground">@color/neutro_97</item>
        <item name="colorOnBackground">@color/neutro_10</item>
        <item name="colorSurface">@color/neutro_99</item>
        <item name="colorOnSurface">@color/neutro_10</item>
        <item name="colorSurfaceVariant">@color/neutro_94</item>
        <item name="colorOnSurfaceVariant">@color/neutro_30</item>
        <item name="colorSurfaceContainer">@color/neutro_94</item>
        <item name="colorSurfaceContainerHigh">@color/neutro_90</item>
        <item name="colorOutline">@color/neutro_60</item>
        <item name="colorOutlineVariant">@color/neutro_80</item>

        <!-- Barras del sistema -->
        <item name="android:statusBarColor">@color/aurora_20</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:navigationBarColor">?attr/colorSurface</item>
        <item name="android:windowLightNavigationBar">true</item>

        <!-- Tipografía de la app -->
        <item name="textAppearanceDisplaySmall">@style/TextAppearance.App.DisplaySmall</item>
        <item name="textAppearanceHeadlineMedium">@style/TextAppearance.App.HeadlineMedium</item>
        <item name="textAppearanceHeadlineSmall">@style/TextAppearance.App.HeadlineSmall</item>
        <item name="textAppearanceTitleLarge">@style/TextAppearance.App.TitleLarge</item>
        <item name="textAppearanceTitleMedium">@style/TextAppearance.App.TitleMedium</item>
        <item name="textAppearanceBodyLarge">@style/TextAppearance.App.BodyLarge</item>
        <item name="textAppearanceBodyMedium">@style/TextAppearance.App.BodyMedium</item>
        <item name="textAppearanceLabelLarge">@style/TextAppearance.App.LabelLarge</item>
        <item name="android:fontFamily">@string/fuente_cuerpo</item>

        <!-- Estilos de componentes por defecto -->
        <item name="materialButtonStyle">@style/Widget.App.Button</item>
        <item name="materialButtonOutlinedStyle">@style/Widget.App.Button.Outlined</item>
        <item name="borderlessButtonStyle">@style/Widget.App.Button.Text</item>
        <item name="materialCardViewStyle">@style/Widget.App.Card</item>
        <item name="textInputStyle">@style/Widget.App.TextInputLayout</item>
        <item name="checkboxStyle">@style/Widget.App.CheckBox</item>
        <item name="radioButtonStyle">@style/Widget.App.RadioButton</item>
        <item name="toolbarStyle">@style/Widget.App.Toolbar</item>
        <item name="bottomNavigationStyle">@style/Widget.App.BottomNavigation</item>
        <item name="floatingActionButtonStyle">@style/Widget.App.Fab</item>
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.App.AlertDialog</item>

        <!-- Formas redondeadas propias -->
        <item name="shapeAppearanceSmallComponent">@style/ShapeAppearance.App.Small</item>
        <item name="shapeAppearanceMediumComponent">@style/ShapeAppearance.App.Medium</item>
        <item name="shapeAppearanceLargeComponent">@style/ShapeAppearance.App.Large</item>
    </style>

    <style name="Theme.Registromultimedia" parent="Base.Theme.Registromultimedia" />

    <!--
        Tema de las pantallas de acceso (login / registro): fondo con degradado
        propio y barra de estado transparente sobre él.
    -->
    <style name="Theme.Registromultimedia.Acceso">
        <item name="android:windowBackground">@drawable/bg_degradado_aurora</item>
        <item name="android:statusBarColor">@color/transparente</item>
        <item name="android:navigationBarColor">@color/transparente</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>

</resources>
